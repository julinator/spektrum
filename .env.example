# KI-Zusammenfassungen: aus = nur Feeds, keine API-Kosten. an = mit Claude (braucht Key und Guthaben).
KI=aus

# Anthropic API-Key, nur nötig mit KI=an (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional
# REFRESH_MINUTES=30                # wie oft neu gelesen wird (Standard: 30 ohne KI, 90 mit KI)
# PORT=8787
# HOURS_BACK=36                     # wie alt Artikel höchstens sein dürfen
# MAX_TOPICS=12
# CLAUDE_MODEL=claude-opus-5-5      # nur mit KI=an; günstiger: claude-sonnet-5-5 oder claude-haiku-5-5
# CLAUDE_EFFORT=medium              # nur mit KI=an
# REUSE_HOURS=6                     # nur mit KI=an: unveränderte Themen so lange wiederverwenden
